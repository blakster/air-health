# Optional environment for Air Health (copy to .env — never commit .env).
# Coach API keys can also be entered in the Coach page UI (saved under data/, gitignored).

# XAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COACH_PROVIDER=xai
# COACH_MODEL=

# APP_PASSCODE=          # optional; otherwise a random one is written to data/.passcode
# PORT=4870

# URL shown on phone-pairing QR when the browser hits localhost (use your Tailscale IP):
# PUBLIC_SYNC_URL=http://100.64.0.1:4870
# TAILSCALE_URL=http://100.64.0.1:4870

# INTRADAY_UTC=true      # set false if minute-level Takeout series are already local time
